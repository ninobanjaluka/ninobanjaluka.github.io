---
import BaseLayout from "./BaseLayout.astro";
import LanguageToggle from "../components/LanguageToggle.astro";

interface Props {
    title: string;
    date: Date;
    excerpt: string;
    section: "photography" | "code" | "life" | "art";
    tags?: string[];
    camera?: string;
    location?: string;
    tech?: string[];
    repo?: string;
    medium?: string;
    tools?: string[];
    coverImage?: string;
    SrContent?: any;
    srExcerpt?: string;
}

const {
    title,
    date,
    excerpt,
    section,
    tags,
    camera,
    location,
    tech,
    repo,
    medium,
    tools,
    coverImage,
    SrContent,
    srExcerpt,
} = Astro.props;

const hasSr = !!SrContent;



const sectionLabel = {
    photography: "Photography",
    code: "Code",
    life: "Life",
    art: "Art",
};
const sectionHref = {
    photography: "/photography",
    code: "/code",
    life: "/life",
    art: "/art",
};

const dateStr = date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
});

const siteBase = "https://ninobanjaluka.github.io";
const postUrl = new URL(Astro.url.pathname, Astro.site).href;
const sectionUrl = new URL(sectionHref[section], Astro.site).href;
const isoDate = date.toISOString();

const postImage = coverImage || "/nino.jpg";
const fullImageURL = new URL(postImage, Astro.site).href;

const blogPostingLd = [
    {
        "@type": "WebPage",
        "@id": `${postUrl}#webpage`,
        "url": postUrl,
        "isPartOf": { "@id": `${siteBase}/#website` },
        "name": title,
        "inLanguage": "en",
        "breadcrumb": { "@id": `${postUrl}#breadcrumb` }
    },
    {
        "@type": "BlogPosting",
        "@id": `${postUrl}#blogposting`,
        "url": postUrl,
        "mainEntityOfPage": { "@id": `${postUrl}#webpage` },
        "isPartOf": { "@id": `${siteBase}/#website` },
        "headline": title,
        "description": excerpt,
        "articleSection": sectionLabel[section],
        "keywords": tags?.join(", "),
        "inLanguage": "en",
        "datePublished": isoDate,
        "dateModified": isoDate,
        "author": { "@id": `${siteBase}/#person` },
        "publisher": { "@id": `${siteBase}/#person` },
        "image": {
            "@type": "ImageObject",
            "@id": `${postUrl}#primaryimage`,
            "url": fullImageURL,
            "width": 1200,
            "height": 630
        }
    },
    {
        "@type": "BreadcrumbList",
        "@id": `${postUrl}#breadcrumb`,
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteBase}/` },
            { "@type": "ListItem", "position": 2, "name": sectionLabel[section], "item": sectionUrl },
            { "@type": "ListItem", "position": 3, "name": title, "item": postUrl }
        ]
    }
];
---

<BaseLayout 
    title={`${title} — ninobanjaluka`} 
    description={excerpt}
    image={postImage}
    type="article"
    jsonLd={blogPostingLd}
>

    {coverImage && (
        <div class="post__hero">
            <img
                src={coverImage}
                alt={title}
                class="post__hero-img"
                data-lightbox="true"
            />
        </div>
    )}

    <article class:list={["post", { "post--has-hero": !!coverImage }]}>
        <header class="post__header">
            <div class="post__meta">
                <a href={sectionHref[section]} class={`tag tag--${section}`}
                    >{sectionLabel[section]}</a
                >
                <span class="post__date">{dateStr}</span>
                <LanguageToggle hasTranslation={hasSr} />
            </div>

            <h1 class="post__title">{title}</h1>
            <p class="post__excerpt" data-lang="en">{excerpt}</p>
            {hasSr && srExcerpt && (
                <p class="post__excerpt" data-lang="sr" style="display:none">{srExcerpt}</p>
            )}

            {
                (section === "photography" || section === "life") && (camera || location) && (
                    <div class="post__details">
                        {camera && (
                            <span class="post__detail">
                                <span class="post__detail-label">Camera</span>
                                {camera}
                            </span>
                        )}
                        {location && (
                            <span class="post__detail">
                                <span class="post__detail-label">Location</span>
                                {location}
                            </span>
                        )}
                    </div>
                )
            }

            {
                section === "code" && (tech || repo) && (
                    <div class="post__details">
                        {tech && (
                            <span class="post__detail">
                                <span class="post__detail-label">Stack</span>
                                {tech?.join(", ")}
                            </span>
                        )}
                        {repo && (
                            <a
                                href={repo}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="post__detail post__detail--link"
                            >
                                <span class="post__detail-label">Repo</span>
                                {repo.replace("https://github.com/", "")}
                            </a>
                        )}
                    </div>
                )
            }

            {
                section === "art" && (medium || tools) && (
                    <div class="post__details">
                        {medium && (
                            <span class="post__detail">
                                <span class="post__detail-label">Medium</span>
                                {medium}
                            </span>
                        )}
                        {tools && (
                            <span class="post__detail">
                                <span class="post__detail-label">Tools</span>
                                {tools?.join(", ")}
                            </span>
                        )}
                    </div>
                )
            }
        </header>

        <div class="prose" data-lang="en">
            <slot />
        </div>
        {hasSr && (
            <div class="prose" data-lang="sr" style="display:none">
                <SrContent />
            </div>
        )}

        {
            tags && tags.length > 0 && (
                <footer class="post__footer">
                    {tags.map((tag) => (
                        <a href={`/tags/${tag}`} class="post__tag">
                            {tag}
                        </a>
                    ))}
                </footer>
            )
        }
    </article>

    <div class="lightbox" data-lightbox-overlay hidden>
        <button class="lightbox__close" data-lightbox-close aria-label="Close">✕</button>
        <img class="lightbox__img" data-lightbox-img alt="" />
    </div>
</BaseLayout>

<script>
    function initLangToggle() {
        const toggle = document.querySelector<HTMLButtonElement>('[data-toggle-lang]');
        if (!toggle) return;

        const enBlocks = document.querySelectorAll<HTMLElement>('[data-lang="en"]');
        const srBlocks = document.querySelectorAll<HTMLElement>('[data-lang="sr"]:not([data-toggle-lang] [data-lang="sr"])');
        if (srBlocks.length === 0) return;

        const enLabel = toggle.querySelector<HTMLElement>('[data-lang="en"]');
        const srLabel = toggle.querySelector<HTMLElement>('[data-lang="sr"]');

        const saved = localStorage.getItem('post-lang');
        if (saved === 'sr') {
            enBlocks.forEach((el) => (el.style.display = 'none'));
            srBlocks.forEach((el) => (el.style.display = ''));
            if (enLabel) enLabel.style.display = 'none';
            if (srLabel) srLabel.style.display = '';
        }

        toggle.addEventListener('click', () => {
            const showingEn = enBlocks[0]?.style.display !== 'none';
            enBlocks.forEach((el) => (el.style.display = showingEn ? 'none' : ''));
            srBlocks.forEach((el) => (el.style.display = showingEn ? '' : 'none'));
            if (enLabel) enLabel.style.display = showingEn ? 'none' : '';
            if (srLabel) srLabel.style.display = showingEn ? '' : 'none';
            localStorage.setItem('post-lang', showingEn ? 'sr' : 'en');
        });
    }
    function initLightbox() {
        const overlay = document.querySelector<HTMLElement>('[data-lightbox-overlay]');
        const overlayImg = document.querySelector<HTMLImageElement>('[data-lightbox-img]');
        const closeBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-close]');
        if (!overlay || !overlayImg || !closeBtn) return;

        const candidates = document.querySelectorAll<HTMLImageElement>(
            '.prose img, [data-lightbox="true"]'
        );
        if (candidates.length === 0) return;

        function centerScroll() {
            const overflowX = overlayImg!.scrollWidth - overlay!.clientWidth;
            if (overflowX > 0) overlay!.scrollLeft = overflowX / 2;
        }

        function openLightbox(img: HTMLImageElement) {
            overlayImg!.src = img.currentSrc || img.src;
            overlayImg!.alt = img.alt || '';
            overlay!.hidden = false;
            overlay!.scrollLeft = 0;
            document.body.style.overflow = 'hidden';
            if (overlayImg!.complete) {
                centerScroll();
            } else {
                overlayImg!.addEventListener('load', centerScroll, { once: true });
            }
        }

        function closeLightbox() {
            overlay!.hidden = true;
            overlayImg!.src = '';
            document.body.style.overflow = '';
        }

        candidates.forEach((img) => {
            img.style.cursor = 'zoom-in';
            img.addEventListener('click', () => openLightbox(img));
        });

        closeBtn.addEventListener('click', closeLightbox);
        overlay.addEventListener('click', (e) => {
            if (e.target === overlay) closeLightbox();
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !overlay!.hidden) closeLightbox();
        });
    }

    initLangToggle();
    initLightbox();
    document.addEventListener('astro:page-load', initLangToggle);
    document.addEventListener('astro:page-load', initLightbox);
</script>

<style>
    .post__hero {
        width: 100%;
        height: 520px;
        overflow: hidden;
    }
    .post__hero-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
    }
    .post {
        max-width: var(--max-w-text);
        margin: 0 auto;
        padding: 80px 48px 120px;
    }
    .post--has-hero {
        padding-top: 48px;
    }
    .post__meta {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 32px;
    }
    .post__date {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        color: var(--color-hint);
    }
    .post__title {
        font-size: clamp(36px, 6vw, 64px);
        color: var(--color-text);
        margin-bottom: 24px;
        letter-spacing: -0.01em;
    }
    .post__excerpt {
        font-size: 20px;
        color: var(--color-muted);
        line-height: 1.6;
        margin-bottom: 32px;
        font-family: var(--font-body);
        font-style: italic;
    }
    .post__details {
        display: flex;
        gap: 28px;
        flex-wrap: wrap;
        margin-bottom: 48px;
        padding-top: 24px;
        border-top: 1px solid var(--color-border);
    }
    .post__detail {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.05em;
        color: var(--color-muted);
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .post__detail--link {
        color: var(--color-accent);
    }
    .post__detail-label {
        font-size: 9px;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--color-hint);
    }
    .post__footer {
        margin-top: 64px;
        padding-top: 32px;
        border-top: 1px solid var(--color-border);
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    .post__tag {
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.1em;
        color: var(--color-hint);
        padding: 4px 10px;
        border: 1px solid var(--color-border);
        border-radius: 2px;
        text-decoration: none;
        transition:
            color 0.2s,
            border-color 0.2s;
    }
    .post__tag:hover {
        color: var(--color-accent);
        border-color: rgba(251, 191, 36, 0.4);
    }
    @media (max-width: 640px) {
        .post__hero {
            height: 260px;
        }
        .post {
            padding: 48px 20px 80px;
        }
        .post--has-hero {
            padding-top: 32px;
        }
    }

    .lightbox {
        position: fixed;
        inset: 0;
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
        background: rgba(8, 8, 8, 0.92);
        backdrop-filter: blur(4px);
        cursor: zoom-out;
        animation: lightbox-fade 0.15s ease-out;
    }
    .lightbox[hidden] {
        display: none;
    }
    .lightbox__img {
        max-width: 100%;
        max-height: 100%;
        border-radius: 4px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
        cursor: default;
    }
    .lightbox__close {
        position: absolute;
        top: 24px;
        right: 32px;
        background: none;
        border: 1px solid var(--color-border);
        color: var(--color-text);
        font-family: var(--font-mono);
        font-size: 16px;
        line-height: 1;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        cursor: pointer;
        transition:
            color 0.2s,
            border-color 0.2s;
    }
    .lightbox__close:hover {
        color: var(--color-accent);
        border-color: rgba(251, 191, 36, 0.4);
    }
    @media (max-width: 640px), (max-height: 500px) {
        .lightbox {
            padding: 0;
            height: 100dvh;
            display: block;
            text-align: center;
            white-space: nowrap;
            overflow-x: auto;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }
        .lightbox::-webkit-scrollbar {
            display: none;
        }
        .lightbox__img {
            display: inline-block;
            height: 100dvh;
            width: auto;
            max-width: none;
            max-height: none;
            vertical-align: middle;
            border-radius: 0;
            box-shadow: none;
        }
        .lightbox__close {
            top: env(safe-area-inset-top, 12px);
            right: env(safe-area-inset-right, 12px);
            background: rgba(8, 8, 8, 0.6);
            border-color: rgba(255, 255, 255, 0.15);
        }
    }
</style>
