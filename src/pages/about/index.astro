---
import BaseLayout from "../../layouts/BaseLayout.astro";

const aboutLd = [
    {
        "@type": "AboutPage",
        name: "About  Nino Katić",
        description: "Photographer, developer, engineer andrtist.",
    },
];
---

<BaseLayout
    title="About  nino"
    description="Photographer, developer, artist from Banja Luka."
    jsonLd={aboutLd}
>
    <div class="list-page">
        <header class="list-page__header">
            <div class="section-label">About</div>
            <h1 class="list-page__title">Nino Katić</h1>
            <p class="list-page__sub">
                Photographer, developer, engineer &amp; artist from Banja Luka.
            </p>
        </header>

        <div class="about">
            <div class="about__photo">
                <img src="/nino.jpg" alt="Nino Katić" class="about__img" />
            </div>

            <div class="about__body">
                <div class="prose">
                    <p>
                        By day I write code, by night I chase light, and vice
                        versa. This site is where all of it comes together;
                        photography, code experiments, art projects and whatever
                        else life throws my way. Sometimes.
                    </p>
                    <p>
                        Feel free to reach out if you want to collaborate, have
                        a question or just want to say hello.
                    </p>
                </div>

                <div class="about__links">
                    <a
                        href="https://github.com/katnino"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="about__link"
                    >
                        <span class="about__link-label">GitHub</span>
                        <span class="about__link-arrow">→</span>
                    </a>
                    <a
                        href="https://github.com/ninobanjaluka"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="about__link"
                    >
                        <span class="about__link-label">GitHub (old)</span>
                        <span class="about__link-arrow">→</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    .about {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 64px;
        align-items: start;
        margin-top: 64px;
    }
    .about__photo {
        position: sticky;
        top: 96px;
    }
    .about__img {
        width: 100%;
        aspect-ratio: 3 / 4;
        object-fit: cover;
        border-radius: 2px;
    }
    .about__body {
        padding-top: 8px;
    }
    .about__links {
        margin-top: 48px;
        display: flex;
        flex-direction: column;
        gap: 0;
    }
    .about__link {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 0;
        border-bottom: 1px solid var(--color-border);
        text-decoration: none;
        transition: background 0.2s;
    }
    .about__link:first-child {
        border-top: 1px solid var(--color-border);
    }
    .about__link:hover {
        background: rgba(255, 255, 255, 0.02);
    }
    .about__link:hover .about__link-label {
        color: var(--color-accent);
    }
    .about__link:hover .about__link-arrow {
        color: var(--color-accent);
        opacity: 1;
    }
    .about__link-label {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-text);
        transition: color 0.2s;
    }
    .about__link-arrow {
        font-family: var(--font-mono);
        font-size: 18px;
        color: var(--color-hint);
        opacity: 0.4;
        transition:
            color 0.2s,
            opacity 0.2s;
    }

    @media (max-width: 640px) {
        .about {
            grid-template-columns: 1fr;
            gap: 40px;
        }
        .about__photo {
            position: static;
            max-width: 240px;
        }
    }
</style>
