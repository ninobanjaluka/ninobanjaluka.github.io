---
import { getCollection, render } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";

const srModules = import.meta.glob("../../content/code/*.sr.mdx", { eager: true });

export async function getStaticPaths() {
    const posts = await getCollection("code", ({ data }) => !data.draft);
    const ids = new Set(posts.map((p) => p.id));
    return posts
        .filter((post) => {
            const base = post.id.replace(/\.?sr$/, "");
            return base === post.id || !ids.has(base);
        })
        .map((post) => ({
            params: { slug: post.id },
            props: { post },
        }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const srKey = Object.keys(srModules).find((k) => k.endsWith(`/${post.id}.sr.mdx`));
const SrContent = srKey ? srModules[srKey].default : undefined;
---

<PostLayout
    title={post.data.title}
    date={post.data.date}
    excerpt={post.data.excerpt}
    section="code"
    tags={post.data.tags}
    tech={post.data.tech}
    repo={post.data.repo}
    coverImage={post.data.coverImage}
    SrContent={SrContent}
>
    <Content />
</PostLayout>
