---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = (
    await getCollection("photography", ({ data }) => !data.draft)
).sort((a, b) => {
    if (a.data.pinned && !b.data.pinned) return -1;
    if (!a.data.pinned && b.data.pinned) return 1;
    return b.data.date.valueOf() - a.data.date.valueOf();
});
---

<BaseLayout
    title="Photography — nino"
    description="Photographs shot on a Canon in and around Banja Luka."
>
    <div class="list-page">
        <header class="list-page__header">
            <div class="section-label">01 / Photography</div>
            <h1 class="list-page__title">Selected frames</h1>
            <p class="list-page__sub">Canon, Banja Luka and beyond.</p>
        </header>
        <div>
            {
                posts.map((post) => (
                    <PostCard
                        title={post.data.title}
                        date={post.data.date}
                        excerpt={post.data.excerpt}
                        href={`/photography/${post.id}`}
                        section="photography"
                        meta={[post.data.camera, post.data.location]
                            .filter(Boolean)
                            .join(" · ")}
                        pinned={post.data.pinned}
                    />
                ))
            }
        </div>
	</div>
</BaseLayout>
