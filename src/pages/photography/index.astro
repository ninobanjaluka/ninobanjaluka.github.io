---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = (
    await getCollection("photography", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
    title="Photography — nino"
    description="Photographs shot on a Canon in and around Banja Luka."
>
    <div class="list-page">
        <header class="list-page__header">
            <div class="section-label">01 / Photography</div>
            <h1 class="list-page__title">Selected frames</h1>
            <p class="list-page__sub">Canon, Banja Luka and beyond.</p>
        </header>
        <div>
            {
                posts.map((post) => (
                    <PostCard
                        title={post.data.title}
                        date={post.data.date}
                        excerpt={post.data.excerpt}
                        href={`/photography/${post.id}`}
                        section="photography"
                        meta={[post.data.camera, post.data.location]
                            .filter(Boolean)
                            .join(" · ")}
                    />
                ))
            }
        </div>
    </div>
</BaseLayout>

<style>
    .list-page {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 80px 48px 120px;
    }
    .list-page__header {
        margin-bottom: 64px;
    }
    .list-page__title {
        font-size: clamp(36px, 5vw, 64px);
        color: var(--color-text);
        margin-bottom: 16px;
    }
    .list-page__sub {
        font-family: var(--font-body);
        font-size: 18px;
        color: var(--color-muted);
        font-style: italic;
    }
    @media (max-width: 640px) {
        .list-page {
            padding: 48px 20px 80px;
        }
    }
</style>
