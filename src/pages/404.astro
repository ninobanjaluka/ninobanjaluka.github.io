---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — noni">
  <div class="not-found">
    <div class="section-label">404</div>
    <h1 class="not-found__title">Frame not found.</h1>
    <p class="not-found__sub">This shot didn't make the cut — or never existed.</p>
    <a href="/" class="not-found__link">← Back home</a>
  </div>
</BaseLayout>

<style>
  .not-found {
    min-height: 80vh; display: flex; flex-direction: column;
    justify-content: center; padding: 0 48px;
    max-width: 600px; margin: 0 auto;
  }
  .not-found__title { font-size: clamp(40px, 6vw, 72px); color: var(--color-text); margin-bottom: 16px; }
  .not-found__sub { font-family: var(--font-body); font-size: 20px; color: var(--color-muted); font-style: italic; margin-bottom: 48px; }
  .not-found__link {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--color-accent); transition: opacity 0.2s;
  }
  .not-found__link:hover { opacity: 0.7; }
</style>
