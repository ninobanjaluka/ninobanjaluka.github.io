---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";

const allPosts = [
    ...(await getCollection("photography", ({ data }) => !data.draft)).map(
        (p) => ({
            ...p,
            section: "photography" as const,
            href: `/photography/${p.id}`,
        }),
    ),
    ...(await getCollection("code", ({ data }) => !data.draft)).map((p) => ({
        ...p,
        section: "code" as const,
        href: `/code/${p.id}`,
    })),
    ...(await getCollection("art", ({ data }) => !data.draft)).map((p) => ({
        ...p,
        section: "art" as const,
        href: `/art/${p.id}`,
    })),
    ...(await getCollection("life", ({ data }) => !data.draft)).map((p) => ({
        ...p,
        section: "life" as const,
        href: `/life/${p.id}`,
    })),
]
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 6);
---

<BaseLayout>
    <section class="hero">
        <div class="hero__bg"></div>
        <div class="hero__content">
            <div class="section-label">Banja Luka, RS/Bih</div>
            <h1 class="hero__title">
                Photographs,<br />
                <span
                    style="font-family: 'IBM Plex Mono', var(--font-mono); color: var(--color-code); font-style: normal; font-size: 0.8em; font-weight: 400;"
                    >coding</span
                >
                &amp; Art.<br />
                My Life.
            </h1>
            <p class="hero__sub">
                I'm Nino. I'm an Artist and an Engineer, I shoot with a Canon
                and occasionally write about what it's like to live in Banja
                Luka, on this planet we call Earth, with a crazy dog named
                Charlie.
            </p>
            <div class="hero__actions">
                <a href="/photography" class="btn btn--primary">See my work</a>
                <a href="/code" class="btn btn--ghost">Read the blog</a>
            </div>
        </div>
    </section>

    <section class="recent">
        <div class="recent__header">
            <div>
                <div class="section-label">Latest</div>
                <h2 class="recent__title">From the blog</h2>
            </div>
            <div class="recent__nav">
                <a href="/photography">Photography</a>
                <a href="/code">Code</a>
                <a href="/art">Art</a>
                <a href="/life">Life</a>
            </div>
        </div>
        <div class="recent__list">
            {
                allPosts.map((post) => (
                    <PostCard
                        title={post.data.title}
                        date={post.data.date}
                        excerpt={post.data.excerpt}
                        href={post.href}
                        section={post.section}
                    />
                ))
            }
        </div>
    </section>
</BaseLayout>

<style>
    .hero {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 0 48px 80px;
        position: relative;
        overflow: hidden;
    }
    .hero__bg {
        position: absolute;
        inset: 0;
        pointer-events: none;

        background:
            linear-gradient(rgba(10, 10, 10, 0.75), rgba(10, 10, 10, 0.85)),
            url("/images/hero-bg.jpg");
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
    }
    .hero__content {
        position: relative;
        max-width: 620px;
    }
    .hero__title {
        font-size: clamp(52px, 7vw, 88px);
        font-weight: 300;
        line-height: 1;
        color: var(--color-text);
        margin: 0 0 32px;
        letter-spacing: -0.01em;
    }
    .hero__title em {
        font-style: italic;
        color: var(--color-muted);
    }
    .hero__sub {
        font-size: 18px;
        line-height: 1.7;
        color: var(--color-muted);
        max-width: 480px;
        margin-bottom: 48px;
        font-family: var(--font-body);
    }
    .hero__actions {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }
    .btn {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        padding: 14px 32px;
        border-radius: 2px;
        transition: all 0.2s;
        border: none;
        text-decoration: none;
        display: inline-block;
    }
    .btn--primary {
        background: var(--color-accent);
        color: #0a0a0a;
        font-weight: 700;
    }
    .btn--primary:hover {
        background: #f5b800;
    }
    .btn--ghost {
        background: none;
        color: var(--color-muted);
        border: 1px solid var(--color-border);
    }
    .btn--ghost:hover {
        border-color: rgba(251, 191, 36, 0.3);
        color: var(--color-accent);
    }

    .recent {
        padding: 80px 48px 120px;
        border-top: 1px solid var(--color-border);
        max-width: var(--max-w);
        margin: 0 auto;
        width: 100%;
    }
    .recent__header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 16px;
    }
    .recent__title {
        font-size: 42px;
        color: var(--color-text);
    }
    .recent__nav {
        display: flex;
        gap: 24px;
    }
    .recent__nav a {
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-hint);
        transition: color 0.2s;
    }
    .recent__nav a:hover {
        color: var(--color-accent);
    }

    @media (max-width: 640px) {
        .hero {
            padding: 0 20px 60px;
        }
        .recent {
            padding: 48px 20px 80px;
        }
        .recent__header {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }
        .recent__nav {
            flex-wrap: wrap;
            gap: 16px;
        }
    }
</style>
