---
import { getCollection, render } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";

const srModules = import.meta.glob("../../content/art/*.sr.mdx", { eager: true });

export async function getStaticPaths() {
    const posts = await getCollection("art", ({ data }) => !data.draft);
    const ids = new Set(posts.map((p) => p.id));
    return posts
        .filter((post) => {
            const base = post.id.replace(/\.?sr$/, "");
            return base === post.id || !ids.has(base);
        })
        .map((post) => ({
            params: { slug: post.id },
            props: { post },
        }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const srKey = Object.keys(srModules).find((k) => k.endsWith(`/${post.id}.sr.mdx`));
const srData = srKey ? srModules[srKey] : undefined;
const SrContent = srData?.default;
const srExcerpt = srData?.frontmatter?.excerpt;
---

<PostLayout
    title={post.data.title}
    date={post.data.date}
    excerpt={post.data.excerpt}
    section="art"
    tags={post.data.tags}
    medium={post.data.medium}
    tools={post.data.tools}
    coverImage={post.data.coverImage}
    SrContent={SrContent}
    srExcerpt={srExcerpt}
>
    <Content />
</PostLayout>
