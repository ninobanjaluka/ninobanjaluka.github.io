---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("art", ({ data }) => !data.draft)).sort(
    (a, b) => {
        if (a.data.pinned && !b.data.pinned) return -1;
        if (!a.data.pinned && b.data.pinned) return 1;
        return b.data.date.valueOf() - a.data.date.valueOf();
    },
);
---

<BaseLayout
    title="Art — nino"
    description="Paintings, Drawings, Digital art, generative experiments and visual explorations."
>
    <div class="list-page">
        <header class="list-page__header">
            <div class="section-label">03 / Art</div>
            <h1 class="list-page__title">Visual experiments</h1>
            <p class="list-page__sub">
                Drawings, paintings, generative work, digital art and things
                made to see what happens.
            </p>
        </header>
        <div>
            {
                posts.map((post) => (
                    <PostCard
                        title={post.data.title}
                        date={post.data.date}
                        excerpt={post.data.excerpt}
                        href={`/art/${post.id}`}
                        section="art"
                        meta={[post.data.medium, post.data.tools?.join(", ")]
                            .filter(Boolean)
                            .join(" · ")}
                        pinned={post.data.pinned}
                    />
                ))
            }
        </div>
	</div>
</BaseLayout>
