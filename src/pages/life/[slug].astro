---
import { getCollection, render } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";
import { filterSrCompanions } from "../../utils/posts";

const srModules = import.meta.glob("../../content/life/*.sr.mdx", { eager: true });

export async function getStaticPaths() {
    const posts = await getCollection("life", ({ data }) => !data.draft);
    return filterSrCompanions(posts).map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const baseId = post.id.replace(/\.?sr$/, "");
const srKey = Object.keys(srModules).find((k) => k.endsWith(`/${baseId}.sr.mdx`));
const srData = srKey ? srModules[srKey] : undefined;
const SrContent = srData?.default;
const srExcerpt = srData?.frontmatter?.excerpt;
const srTitle = srData?.frontmatter?.title;
---

<PostLayout
    title={post.data.title}
    date={post.data.date}
    excerpt={post.data.excerpt}
    section="life"
    tags={post.data.tags}
    camera={post.data.camera}
    location={post.data.location}
    coverImage={post.data.coverImage}
    SrContent={SrContent}
    srExcerpt={srExcerpt}
    srTitle={srTitle}
>
    <Content />
</PostLayout>
