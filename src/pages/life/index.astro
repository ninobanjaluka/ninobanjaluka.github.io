---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";
import { filterSrCompanions } from "../../utils/posts";

const posts = filterSrCompanions(
    await getCollection("life", ({ data }) => !data.draft),
).sort((a, b) => {
    if (a.data.pinned && !b.data.pinned) return -1;
    if (!a.data.pinned && b.data.pinned) return 1;
    return b.data.date.valueOf() - a.data.date.valueOf();
});
---

<BaseLayout
    title="Life — nino"
    description="Writing about life in Banja Luka and everything else."
>
    <div class="list-page">
        <header class="list-page__header">
            <div class="section-label">Life</div>
            <h1 class="list-page__title">Life in general</h1>
            <p class="list-page__sub">
                Laptop, Charlie, bass guitar and whatever else is going on.
            </p>
        </header>
        <div>
            {
                posts.map((post) => (
                    <PostCard
                        title={post.data.title}
                        date={post.data.date}
                        excerpt={post.data.excerpt}
                        href={`/life/${post.id}`}
                        section="life"
                        pinned={post.data.pinned}
                    />
                ))
            }
        </div>
	</div>
</BaseLayout>
