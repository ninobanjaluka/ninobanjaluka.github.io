---
interface Props {
  title: string;
  date: Date;
  excerpt: string;
  href: string;
  section: 'photography' | 'code' | 'life' | 'art';
  meta?: string;
  pinned?: boolean;
}

const { title, date, excerpt, href, section, meta, pinned } = Astro.props;

const dateStr = date.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric',
});

const sectionLabel = { photography: 'Photography', code: 'Code', life: 'Life', art: 'Art' };
---

{
  pinned && (
    <div class="pinned-divider">
      <span class="pinned-divider__label">pinned</span>
    </div>
  )
}
<a href={href} class={`card${pinned ? ' card--pinned' : ''}`}>
  <div class="card__left">
    <div class="card__date">{dateStr}</div>
    {pinned && <div class="card__pinned">pinned post</div>}
    <span class={`tag tag--${section}`}>{sectionLabel[section]}</span>
  </div>
  <div class="card__body">
    <h2 class="card__title">{title}</h2>
    <p class="card__excerpt">{excerpt}</p>
    {meta && <div class="card__meta">{meta}</div>}
  </div>
  <div class="card__right">
    <div class="card__arrow">→</div>
  </div>
</a>

<style>
  .card {
    display: grid;
    grid-template-columns: 120px 1fr 48px;
    gap: 28px; align-items: start;
    padding: 32px 0;
    border-bottom: 1px solid var(--color-border);
    cursor: pointer; transition: background 0.2s;
    text-decoration: none;
  }
  .card--pinned {
    border-left: 2px solid var(--color-accent);
    padding-left: 24px;
  }
  .card:hover { background: rgba(255,255,255,0.02); }
  .card:hover .card__title { color: var(--color-accent); }
  .card:hover .card__arrow { color: var(--color-accent); opacity: 1; }
  .card__date {
    font-family: var(--font-mono); font-size: 9px;
    letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--color-hint); margin-bottom: 8px;
  }
  .card__pinned {
    font-family: var(--font-mono); font-size: 9px;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-code); margin-bottom: 6px;
  }
  .pinned-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 48px;
    margin-bottom: 8px;
  }
  .pinned-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }
  .pinned-divider__label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-code);
    white-space: nowrap;
  }
  .card__title {
    font-family: var(--font-serif); font-size: 22px;
    font-weight: 400; color: var(--color-text);
    margin-bottom: 10px; line-height: 1.25;
    transition: color 0.2s;
  }
  .card--pinned .card__title {
    font-size: 26px;
  }
  .card__excerpt {
    font-family: var(--font-body); font-size: 16px;
    color: var(--color-muted); line-height: 1.6;
  }
  .card__meta {
    font-family: var(--font-mono); font-size: 10px;
    letter-spacing: 0.08em; color: var(--color-hint); margin-top: 10px;
  }
  .card__right { text-align: right; padding-top: 4px; }
  .card__arrow {
    font-family: var(--font-mono); font-size: 18px;
    color: var(--color-hint); opacity: 0.4;
    transition: color 0.2s, opacity 0.2s;
  }
  @media (max-width: 640px) {
    .card { grid-template-columns: 1fr; gap: 12px; padding: 24px 0; }
    .card__left { display: flex; gap: 12px; align-items: center; }
    .card__right { display: none; }
  }
</style>
